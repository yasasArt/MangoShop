# PostgreSQL connection string.
# Local:  postgresql://postgres:password@localhost:5432/mangoshop?schema=public
# Neon:   postgresql://user:pass@ep-xxx.aws.neon.tech/mangoshop?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/mangoshop?schema=public"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-this-to-a-long-random-string-at-least-32-characters"
